# Optional server-only merchant API proxy target. Leave unset for public fixture-only mode.
MERCHANT_API_URL=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
QUOTESEAL_DEMO_ADMIN_KEY=
QUOTESEAL_DEMO_LIVE_ENABLED=false

# Read-only Arkiv credentials used only by Next.js server routes.
ARKIV_ACCESS_KEY=
ARKIV_TRUSTED_OWNER=
