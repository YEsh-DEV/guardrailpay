{
  "name": "quoteseal",
  "version": "0.1.0",
  "private": true,
  "description": "Merchant-authorized payment identity for autonomous x402 agents",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "forge:build": "cd contracts && forge build",
    "forge:test": "cd contracts && forge test -vvv"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  }
}
