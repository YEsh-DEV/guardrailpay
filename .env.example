# ==============================================================================
# QuoteSeal Backend Environment Configuration Example
# Copy this file to .env and provide appropriate values.
# NEVER commit .env or secrets to git.
# ==============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database Connection
# Local-only value; keep the password aligned with POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://quoteseal:local-only-password@127.0.0.1:5432/quoteseal

# Ethereum Sepolia RPC Providers (Dual-RPC Verification)
# Must be two independent providers with no shared infrastructure
SEPOLIA_RPC_URL_PRIMARY=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL_SECONDARY=https://gateway.tenderly.co/public/sepolia
FINALITY_CONFIRMATIONS=2
MAX_BLOCK_DIVERGENCE_TOLERANCE=3

# ENSv2 & QuoteSeal Contract Deployments (Sepolia Testnet)
ENS_REGISTRY_ADDRESS=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ENS_RESOLVER_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
# ROTATION_CONTROLLER_ADDRESS=<verified-controller-address>

# Security & Verification
APPLICATION_CHAIN_ID=11155111
MAX_PAYMENT_AMOUNT_DEFAULT=500000000
ROTATION_TIMELOCK_SECONDS=86400

# Cryptographic Salt & Key Storage
# Must be 32+ bytes (random hex or passphrase) in production
OPERATOR_SUBJECT_HMAC_SECRET=sample_32_byte_hmac_secret_for_subject_hashing_min32
ENCRYPTION_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# World ID OIDC Configuration
# Official World ID Issuer: https://auth.world.org (or https://id.worldcoin.org)
WORLD_ID_ISSUER=https://auth.world.org
WORLD_ID_CLIENT_ID=app_staging_quoteseal_world_id
# WORLD_ID_CLIENT_SECRET=optional_confidential_client_secret
WORLD_ID_REDIRECT_URI=http://localhost:4000/v1/world/callback
WORLD_ID_REQUIRED_ACR=orb
WORLD_ID_MAX_AUTH_AGE_SECONDS=120

# QuoteSeal Backend Attestor Service (EIP-712 Signing Key)
# Dedicated signing key for RotationController EIP-712 attestations.
# In production, load this from AWS Secrets Manager / Vault / HSM.
ATTESTOR_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
ATTESTATION_TTL_SECONDS=300


# Runtime profile. Local development never substitutes an in-memory database.
APP_PROFILE=local-development
POSTGRES_PASSWORD=local-only-password

# Required for testnet-demo / production. Set only from verified deployment and
# account configuration; no sample values are supplied here.
# ROTATION_CONTROLLER_CODE_HASH=<deployed-runtime-keccak256>
# ENS_MERCHANT_NAME=<normalized-name.eth>
# ENS_NAMEHASH=<bytes32>
# ENS_RESOLVER_ADDRESS=<address>
# ENS_EXPECTED_OWNER=<address>
# WORLD_ID_ACTION=<registered-action-or-policy-label>
# HEDERA_NETWORK=testnet
# HEDERA_ACCOUNT_ID=0.0.<account-number>
# X402_FACILITATOR_URL=https://<facilitator>
# X402_NETWORK=hedera:testnet
# X402_SCHEME=exact
# X402_ASSET=0.0.<token-number-or-0-for-HBAR>
# X402_AMOUNT=<integer-in-base-units>
